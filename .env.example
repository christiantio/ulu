# Copy to .env.local (git-ignored) or set these in the host's build environment. All are optional; local dev
# needs none of them. Vite bakes them into the bundle, so never put a secret here. See "Deploy settings" in
# README.md.

# The site's origin, for the absolute og:url and og:image link-preview tags. Set it for the production build.
VITE_SITE_URL=

# Cookie-less analytics, production build only. Leave VITE_ANALYTICS_PROVIDER empty to turn it off.
# plausible or umami
VITE_ANALYTICS_PROVIDER=
# The provider's script URL, e.g. https://plausible.io/js/script.js or https://cloud.umami.is/script.js
VITE_ANALYTICS_SRC=
# The production hostname, e.g. ulu.sg. Nothing is sent from any other host
VITE_ANALYTICS_DOMAIN=
# Umami only: the website id from the Umami dashboard
VITE_ANALYTICS_WEBSITE_ID=

# The player form for answer reports: a Google Forms or Tally prefill link with these placeholders, each
# replaced by a URL-encoded value:
#   {date}     the dive's Singapore date (YYYY-MM-DD), or "unlimited"
#   {prompt}   the prompt id, e.g. transport-ccl-stations
#   {guesses}  the rejected guesses, separated by "; " (empty for wrong-answer and tier reports)
#   {kind}     "Missing answer", "Wrong answer" or "Tier feels off" (the form's choices must match exactly)
# Leave it unset to link to the team's GitHub issue form, .github/ISSUE_TEMPLATE/answer-report.yml.
#
# VITE_REPORT_URL=https://docs.google.com/forms/d/e/<form-id>/viewform?usp=pp_url&entry.1111={kind}&entry.2222={date}&entry.3333={prompt}&entry.4444={guesses}
# VITE_REPORT_URL=https://tally.so/r/<form-id>?kind={kind}&date={date}&prompt={prompt}&guesses={guesses}
